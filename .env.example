# =========================
# DATABASE
# =========================
# PostgreSQL (Neon / Supabase / Railway / local)
# Replace user, password, host, and database name with your own values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# =========================
# NEXTAUTH
# =========================
NEXTAUTH_URL="http://localhost:3000"
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# =========================
# APP
# =========================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vailmora"
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs"

# =========================
# STRIPE
# =========================
# Use test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =========================
# CLOUDINARY (image uploads)
# =========================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# =========================
# EMAIL (Resend)
# =========================
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
# Use onboarding@resend.dev for testing; use your verified domain in production
EMAIL_FROM="Vailmora <onboarding@resend.dev>"

# =========================
# ADMIN SEED CREDENTIALS
# =========================
# Used only by `prisma db seed` — set a strong password locally; do not reuse in production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
